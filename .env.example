# Base de datos. Por defecto SQLite local; en producción PostgreSQL.
DATABASE_URL=sqlite:///instance/local_scene.db

# URL que el navegador usa para llegar a la API (Next.js).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# URL pública del sitio (SEO: metadatos, sitemap, robots). Por defecto el
# dominio final; para una prueba en *.vercel.app apuntar a esa URL.
NEXT_PUBLIC_SITE_URL=https://fronteragrande.mx

# Orígenes permitidos por CORS en la API (separados por coma). En producción
# debe incluir el dominio final de la web (por ejemplo, https://fronteragrande.mx
# y cualquier dominio de preview de Vercel).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://fronteragrande.mx

# Contraseña del panel de administración (vacío = admin deshabilitado).
ADMIN_PASSWORD=

# Web Push (PWA). Generar el par con `scripts/generar_vapid.py`. Sin estas
# variables el envío se omite en silencio (el resto de la app funciona igual).
# `NEXT_PUBLIC_VAPID_PUBLIC_KEY` (misma clave pública) va en Vercel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@fronteragrande.mx
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Credenciales opcionales para el adaptador de Spotify (scraper).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Playlist semanal "Frontera Grande: Descubrimiento Semanal". El refresh token
# se obtiene con `python scripts/generar_playlist_semanal.py --auth` (una vez) y
# se guarda como secreto SPOTIFY_PLAYLIST_REFRESH_TOKEN en GitHub Actions.
# Importante: Spotify no permite CREAR playlists vía API en apps en modo
# desarrollo (403). Crea la playlist manualmente en Spotify y define
# SPOTIFY_PLAYLIST_ID con su ID: el script solo la rellenará.
# PLAYLIST_TAMANIO (24) y PLAYLIST_CANCIONES_POR_ARTISTA (2) ajustan la rotación.
SPOTIFY_PLAYLIST_REFRESH_TOKEN=
SPOTIFY_PLAYLIST_ID=
PLAYLIST_TAMANIO=24
PLAYLIST_CANCIONES_POR_ARTISTA=2
PLAYLIST_NOMBRE=Frontera Grande: Descubrimiento Semanal

# Clave de YouTube Data API v3 para suscriptores y vistas públicas de canales.
# Sin esta variable el script de sincronización no modifica la base de datos.
YOUTUBE_API_KEY=

# Credenciales de Meta (app de Facebook Developers) para sincronizar
# posts de Facebook/Instagram de las páginas que el artista administra.
# Dejar vacías desactiva la conexión (la app sigue como puente manual).
META_APP_ID=
META_APP_SECRET=
# URL de callback registrada en la app de Meta (debe coincidir).
# Desarrollo: HTTPS obligatorio, usa un túnel cloudflared.
META_REDIRECT_URI=http://127.0.0.1:8000/api/feed/igfb/callback
# URL de la web a la que el callback de OAuth redirige al terminar.
# Producción: https://fronteragrande.mx
WEB_URL=http://127.0.0.1:3000
# URL pública de la API (para las tarjetas promocionales: Facebook debe
# poder descargarlas al publicar el post de bienvenida).
API_PUBLIC_URL=http://127.0.0.1:8000

# Credenciales de TikTok (TikTok for Developers / Business API) para
# sincronizar seguidores (`followers_tt`) y videos de artistas que conectan
# su cuenta. Dejar vacías desactiva la conexión.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# URL de callback registrada en la app de TikTok (debe coincidir).
TIKTOK_REDIRECT_URI=http://127.0.0.1:8000/api/feed/tiktok/callback
# Scopes solicitados al autorizar. `user.info.basic` es estándar; añadir
# `video.list` solo cuando TikTok lo apruebe (ver docs/tiktok.md).
TIKTOK_SCOPES=user.info.basic

# Página oficial de Frontera Grande (la marca) para posts promocionales.
# Al verificar un artista, se publica un post de bienvenida en esta página
# etiquetando al artista. Requiere token de página con permiso `pages_manage_posts`.
# FG_PAGE_ID: ID de la página (p. ej. 1567063665051085).
# FG_PAGE_TOKEN: token permanente de la página. Obtenerlo con
#   scripts/obtener_token_pagina.py (flujo OAuth, no expira) → se guarda como
#   secret FG_PAGE_TOKEN en GitHub Actions. Alternativa manual: Graph API
#   Explorer → user token con pages_manage_posts → /{page_id}?fields=access_token
#   → fb_exchange_token (ese dura 60 días).
FG_PAGE_ID=
FG_PAGE_TOKEN=
# Ruta (opcional) donde el flujo guarda el token obtenido; default data/fg_page_token.txt
# FG_PAGE_TOKEN_FILE=data/fg_page_token.txt
# Publicación directa de posts de bienvenida (sin draft).
# true = publica al verificar; false = solo genera tarjeta (default).
PROMO_AUTO_PUBLISH=false
# Publicación en Instagram además de Facebook.
# true = publica también en IG @fronteragrande; false = solo FB (default).
PROMO_IG=false
