# Base de datos. Por defecto SQLite local; en producción PostgreSQL.
DATABASE_URL=sqlite:///instance/local_scene.db

# URL que el navegador usa para llegar a la API (Next.js).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# URL pública del sitio (SEO: metadatos, sitemap, robots). Por defecto el
# dominio final; para una prueba en *.vercel.app apuntar a esa URL.
NEXT_PUBLIC_SITE_URL=https://fronteragrande.mx

# Orígenes permitidos por CORS en la API (separados por coma). En producción
# debe incluir el dominio de la web (Vercel).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Contraseña del panel de administración (vacío = admin deshabilitado).
ADMIN_PASSWORD=

# Credenciales opcionales para el adaptador de Spotify (scraper).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Credenciales de Meta (app de Facebook Developers) para sincronizar
# posts de Facebook/Instagram de las páginas que el artista administra.
# Dejar vacías desactiva la conexión (la app sigue como puente manual).
META_APP_ID=
META_APP_SECRET=
# URL de callback registrada en la app de Meta (debe coincidir).
# Desarrollo: HTTPS obligatorio, usa un túnel cloudflared.
META_REDIRECT_URI=http://127.0.0.1:8000/api/feed/igfb/callback
# URL de la web a la que el callback de OAuth redirige al terminar.
WEB_URL=http://127.0.0.1:3000

# Credenciales de TikTok (TikTok for Developers / Business API) para
# sincronizar seguidores (`followers_tt`) y videos de artistas que conectan
# su cuenta. Dejar vacías desactiva la conexión.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# URL de callback registrada en la app de TikTok (debe coincidir).
TIKTOK_REDIRECT_URI=http://127.0.0.1:8000/api/feed/tiktok/callback
# Scopes solicitados al autorizar. `user.info.basic` es estándar; añadir
# `video.list` solo cuando TikTok lo apruebe (ver docs/tiktok.md).
TIKTOK_SCOPES=user.info.basic
